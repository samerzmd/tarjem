# ---- required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Bazarr -> Settings -> General -> Security -> API key
BAZARR_API_KEY=

# ---- model ----------------------------------------------------------------
LLM_PROVIDER=anthropic
# claude-opus-5 is the best translator. claude-sonnet-5 costs roughly a third
# as much per file and is a very reasonable choice for a full-library backfill.
LLM_MODEL=claude-opus-5
# Translation is not a reasoning task; low effort keeps cost and latency down.
LLM_EFFORT=low

# ---- Arabic ---------------------------------------------------------------
# msa | msa-light | gulf | egyptian | levantine
ARABIC_REGISTER=msa
MAX_LINE_CHARS=42
MAX_LINES=2
# Drop [door creaks] / SPEAKER: annotations when the only source is an SDH track
STRIP_HI=false

# ---- behaviour ------------------------------------------------------------
SWEEP_ENABLED=true
SWEEP_INTERVAL_MIN=360
# How many videos one sweep may queue. Keeps a first run from spending the
# whole month's budget in an afternoon.
SWEEP_LIMIT=50
# bazarr = ask Bazarr what is missing (respects your language profiles)
# disk   = walk MEDIA_ROOTS looking for videos with no .ar.srt
SWEEP_SOURCE=bazarr
BATCH_SIZE=40
CONTEXT_CUES=8
DRY_RUN=false

# ---- optional -------------------------------------------------------------
# Shared secret for the webhook and API. Leave empty to run open on the LAN.
TARJEM_TOKEN=
# A whisper-asr-webservice / subgen endpoint, used only when a video has no
# text subtitle at all. Leave empty to skip that fallback.
# WHISPER_URL=http://subgen:8000
# Only needed if bazarr and tarjem mount the media at different paths:
# PATH_MAP=/media/movies:/movies,/media/tv:/tv
LOG_LEVEL=INFO

# ---- Self-hosted / OpenAI-compatible --------------------------------------
# Works with Ollama, vLLM, LM Studio, llama.cpp and OpenAI itself. The provider
# negotiates down automatically if the server rejects strict json_schema.
#
# Ollama (point at the OpenAI-compatible /v1 path, not the native API):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://ollama-host:11434/v1
# OPENAI_MODEL=qwen3:14b
# OPENAI_API_KEY=ollama          # ignored by Ollama, but some servers want a header
#
# Read the throughput section of the README before committing to a CPU-only
# box: a 14B model at ~1.8 tok/s is roughly 15 minutes per 40-cue batch.
# LLM_TIMEOUT=2400
#
# Extra JSON merged into the request body, for server-specific switches.
# {"think": false} stops a reasoning model spending output tokens thinking.
# LLM_EXTRA_BODY={"think": false}
#
# OpenAI proper:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
