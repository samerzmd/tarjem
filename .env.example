# ---- required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Bazarr -> Settings -> General -> Security -> API key
BAZARR_API_KEY=

# ---- model ----------------------------------------------------------------
LLM_PROVIDER=anthropic
# claude-opus-5 is the best translator. claude-sonnet-5 costs roughly a third
# as much per file and is a very reasonable choice for a full-library backfill.
LLM_MODEL=claude-opus-5
# Translation is not a reasoning task; low effort keeps cost and latency down.
LLM_EFFORT=low

# ---- Arabic ---------------------------------------------------------------
# msa | msa-light | gulf | egyptian | levantine
ARABIC_REGISTER=msa
MAX_LINE_CHARS=42
MAX_LINES=2
# Drop [door creaks] / SPEAKER: annotations when the only source is an SDH track
STRIP_HI=false

# ---- behaviour ------------------------------------------------------------
SWEEP_ENABLED=true
SWEEP_INTERVAL_MIN=360
# How many videos one sweep may queue. Keeps a first run from spending the
# whole month's budget in an afternoon.
SWEEP_LIMIT=50
# bazarr = ask Bazarr what is missing (respects your language profiles)
# disk   = walk MEDIA_ROOTS looking for videos with no .ar.srt
SWEEP_SOURCE=bazarr
BATCH_SIZE=40
CONTEXT_CUES=8
DRY_RUN=false

# ---- optional -------------------------------------------------------------
# Shared secret for the webhook and API. Leave empty to run open on the LAN.
TARJEM_TOKEN=
# A whisper-asr-webservice / subgen endpoint, used only when a video has no
# text subtitle at all. Leave empty to skip that fallback.
# WHISPER_URL=http://subgen:8000
# Only needed if bazarr and tarjem mount the media at different paths:
# PATH_MAP=/media/movies:/movies,/media/tv:/tv
LOG_LEVEL=INFO

# ---- Self-hosted: Ollama --------------------------------------------------
# Use this rather than the OpenAI-compatible provider below when talking to
# Ollama. Only the native API honours think:false, and a reasoning model left
# thinking spends roughly ten times the output tokens on the same translation.
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama-host:11434
# OLLAMA_MODEL=qwen3:14b
# Must comfortably exceed one batch plus its glossary. Ollama truncates an
# over-long prompt silently, and the cues simply come back missing.
# OLLAMA_NUM_CTX=8192
#
# Read the throughput section of the README before committing to a CPU-only
# box: a 14B model at ~1.5 tok/s is roughly 15 minutes per 40-cue batch.
# LLM_TIMEOUT=2400
# Merged into Ollama's "options" - sampling knobs, num_gpu, and so on.
# LLM_EXTRA_BODY={"temperature": 0.3}

# ---- Self-hosted: anything else OpenAI-compatible -------------------------
# vLLM, LM Studio, llama.cpp, OpenRouter. The provider negotiates down on its
# own if the server rejects strict json_schema or wants a different token
# parameter, and copes with models that wrap JSON in prose or <think> tags.
#
# OpenAI proper:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
